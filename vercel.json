{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Permissions-Policy": "browsing-topics=(), interest-cohort=()",
        "Vary": "Accept, Accept-Encoding",
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'self' https://jsonvisualiser.com https://markdownvisualizer.com; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.clarity.ms https://static.cloudflareinsights.com https://us.i.posthog.com https://us-assets.i.posthog.com; worker-src 'self' blob:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.clarity.ms https://c.bing.com https://cloudflareinsights.com https://us.i.posthog.com https://us-assets.i.posthog.com"
      },
      "continue": true
    },
    {
      "src": "/sw\\.js",
      "headers": {
        "Content-Type": "application/javascript; charset=utf-8",
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'"
      },
      "continue": true
    },
    {
      "src": "/_next/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/fonts/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/whatsapp/?$",
      "status": 308,
      "headers": {
        "Location": "https://wa.me/919631333128"
      }
    },
    {
      "src": "^/about\\.md$",
      "status": 308,
      "headers": {
        "Location": "/index.md"
      }
    },
    {
      "src": "^/markdown-visualizer(?:/.*)?/?$",
      "status": 308,
      "headers": {
        "Location": "/project/markdown-visualizer"
      }
    },
    {
      "src": "^/json-visualiser(?:/.*)?/?$",
      "status": 308,
      "headers": {
        "Location": "/project/json-visualiser"
      }
    },
    {
      "src": "^/about/?$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/(?:hi/?)?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "text/markdown.*"
        }
      ],
      "headers": {
        "Vary": "Accept, Accept-Encoding"
      },
      "dest": "/index.md"
    },
    {
      "src": "^/(?:hi/)?(?!api(?:/|$)|_next/|.*\\.[^/]+$)(.+?)/?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "text/markdown.*"
        }
      ],
      "headers": {
        "Vary": "Accept, Accept-Encoding"
      },
      "dest": "/$1.md"
    },
    {
      "src": "^/resume/?$",
      "dest": "https://cdn.jsdelivr.net/gh/thatbeautifuldream/resume-tex/resume.pdf"
    },
    {
      "handle": "filesystem"
    }
  ],
  "framework": "nextjs",
  "buildCommand": "pnpm build"
}
