{
  "name": "portfolio-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/generate.ts && next dev --webpack --port 4321",
    "build": "tsx scripts/generate.ts && next build --webpack && node scripts/export.ts",
    "preview": "node scripts/serve-dist.ts 4321",
    "lighthouse": "node scripts/lighthouse.ts",
    "test:agentic": "node --test scripts/agentic.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "pnpm format:check && pnpm check && pnpm build",
    "prepare": "husky",
    "test:migration": "tsx --test scripts/migration.test.ts",
    "test:pwa": "node --test scripts/pwa.test.ts"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "dependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "entities": "^8.1.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "next": "^16.4.0",
    "posthog-js": "^1.395.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "satori": "^0.47.1",
    "sharp": "^0.35.2",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.1",
    "torph": "^0.1.3",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
