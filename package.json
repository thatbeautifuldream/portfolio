{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/generate.ts && next dev --webpack --port 4321",
    "build": "tsx scripts/generate.ts && next build --webpack",
    "preview": "next start --port 4321",
    "lighthouse": "node scripts/lighthouse.ts",
    "check": "next typegen && tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "node --experimental-strip-types scripts/lint-filenames.ts",
    "verify": "pnpm lint && pnpm format:check && pnpm check && pnpm build",
    "verify:ci": "pnpm audit && pnpm verify && pnpm test:filenames && pnpm test:hooks && pnpm test:libraries && pnpm test:content && pnpm test:i18n && pnpm test:migration && pnpm test:pwa",
    "prepare": "husky",
    "test:migration": "tsx --test scripts/migration.test.ts",
    "test:pwa": "node --test scripts/pwa.test.ts",
    "test:content": "tsx --test scripts/content.test.ts",
    "test:i18n": "tsx --test scripts/i18n.test.ts",
    "test:libraries": "tsx --test scripts/libraries.test.ts",
    "test:filenames": "node --experimental-strip-types --test scripts/lint-filenames.test.ts",
    "test:hooks": "node --test scripts/pre-commit.test.ts",
    "start": "next start"
  },
  "lint-staged": {
    "*": [
      "node --experimental-strip-types scripts/lint-filenames.ts",
      "prettier --ignore-unknown --write"
    ]
  },
  "dependencies": {
    "@iconify-json/ri": "^1.2.10",
    "entities": "^8.1.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "next": "^16.4.0",
    "posthog-js": "^1.438.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satori": "^0.47.1",
    "sharp": "^0.35.5",
    "torph": "^0.1.3"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "husky": "^9.1.7",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  }
}
