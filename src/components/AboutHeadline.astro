---
import { Icon } from "astro-icon/components";
import { aboutCopy } from "../data/about";
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = aboutCopy[locale];
const groups = [
  {
    before: copy.before,
    punctuation: locale === "en" ? "," : "",
    values: copy.subjects,
    label: copy.changeSubject,
    icons: ["ri:layout-4-fill", "ri:apps-2-fill", "ri:lightbulb-flash-fill"],
    colors: ["text-sky-500", "text-violet-500", "text-amber-500"],
  },
  {
    before: copy.between,
    punctuation: locale === "en" ? "," : "",
    values: copy.tools,
    label: copy.changeTool,
    logos: ["react", "nextjs", "tanstack", "expo"],
  },
  {
    before: copy.after,
    punctuation: locale === "en" ? "." : "।",
    values: copy.qualities,
    label: copy.changeQuality,
    icons: ["ri:cursor-fill", "ri:magic-fill", "ri:heart-3-fill"],
    colors: ["text-emerald-500", "text-violet-500", "text-rose-500"],
  },
];
---

<div class="grid gap-4">
  <p class="text-muted-foreground text-base/7 sm:text-sm/6">
    {copy.greeting}
  </p>
  <div class="about-heading-flow">
    <h1
      class="about-heading max-w-[35ch] text-3xl font-medium tracking-tight sm:text-4xl"
    >
      {
        groups.map((group) => (
          <>
            {group.before}{" "}
            <span class="inline-flex items-baseline whitespace-nowrap">
              <button
                type="button"
                class="morph-word"
                data-morph-words={JSON.stringify(group.values)}
                aria-label={`${group.label}: ${group.values[0]}`}
                data-label={group.label}
              >
                <span class="morph-icon-slot" aria-hidden="true">
                  {group.values.map((_, index) => (
                    <span
                      class="morph-icon"
                      data-morph-icon={index}
                      hidden={index !== 0}
                    >
                      {group.logos ? (
                        <>
                          <img
                            src={`/icons/about/${group.logos[index]}-light.svg`}
                            alt=""
                            width="36"
                            height="36"
                            class="dark:hidden"
                          />
                          <img
                            src={`/icons/about/${group.logos[index]}-dark.svg`}
                            alt=""
                            width="36"
                            height="36"
                            class="not-dark:hidden"
                          />
                        </>
                      ) : (
                        <Icon
                          name={group.icons![index]!}
                          class={group.colors![index]}
                        />
                      )}
                    </span>
                  ))}
                </span>
                <span data-morph-text>{group.values[0]}</span>
              </button>
              <span>{group.punctuation}</span>
            </span>{" "}
          </>
        ))
      }
    </h1>
  </div>
</div>

<script>
  import "../scripts/about-motion";
</script>

<style>
  .about-heading {
    line-height: 1.35;
    text-wrap: balance;
  }

  .morph-word {
    position: relative;
    display: inline-block;
    max-width: 100%;
    padding: 0.02em 0.38em 0.02em 1.32em;
    line-height: 1.18;
    white-space: nowrap;
    border-radius: 999px;
    corner-shape: round;
    background: var(--muted);
    vertical-align: baseline;
    cursor: pointer;
    text-align: left;
  }

  .morph-icon-slot {
    position: absolute;
    left: 0.16em;
    top: 50%;
    width: 1em;
    height: 1em;
    transform: translateY(-50%);
  }

  .morph-icon {
    position: absolute;
    inset: 0;
    overflow: visible;
    transform: rotate(-8deg);
  }

  .morph-icon :global(img),
  .morph-icon :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    overflow: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-heading-flow {
      transition: height 550ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .morph-icon:not([hidden]) {
      animation: icon-in 550ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }

  @keyframes icon-in {
    from {
      opacity: 0;
      transform: translateY(3px) rotate(-18deg) scale(0.85);
    }
  }

  .morph-word:hover {
    background: var(--accent);
  }

  .morph-word:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }

  @media (max-width: 639px) {
    .about-heading {
      font-size: clamp(1.5rem, 7.2vw, 1.875rem);
    }
  }
</style>
